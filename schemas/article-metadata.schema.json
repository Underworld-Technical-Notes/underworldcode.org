{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underworldcode.org/schemas/article-metadata-1.json",
  "title": "Underworld Technical Note metadata",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "article_type",
    "status",
    "authors",
    "license",
    "canonical_path"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^UWTN [0-9]{4}-[0-9]{3}$",
      "description": "Article identifier, e.g. 'UWTN 2026-003'. Numbered across the whole corpus by publication date, so backfilling older articles never renumbers published ones. Once an ID appears in a deposited PDF it must never change."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "URL slug. For migrated articles this is fixed by the registered DOI and must not be changed."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "article_type": {
      "type": "string",
      "enum": [
        "technical-note",
        "worked-example",
        "benchmark",
        "development-note",
        "how-to",
        "commentary",
        "release-note",
        "news"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "accepted",
        "published",
        "migrated",
        "superseded",
        "withdrawn"
      ]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
              }
            ],
            "description": "Validated syntactically, including the check digit's X form. Null is allowed but warned about on DOI-bearing articles."
          },
          "affiliation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "publication_date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC0-1.0"
      ]
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^/[a-z0-9-]+/$"
    },
    "legacy_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.*/$"
      }
    },
    "figures": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "ghost-migration",
        "native"
      ]
    },
    "ghost_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "underworld_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discussion_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the deposited record. Set once archive_doi exists; the publish command refuses to create a second record when it is present."
    },
    "banner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Feature image kept for the web rendition only; removed for the archival PDF."
    },
    "banner_credit": {
      "type": [
        "string",
        "null"
      ],
      "description": "Photographer attribution, as Unsplash's licence asks for. Carried from Ghost's feature_image_caption."
    },
    "subjects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "earthquakes-faults",
          "mantle-convection",
          "planetary",
          "rheology",
          "surface-processes",
          "tectonics-lithosphere"
        ]
      },
      "description": "Earth-science subject facets, from vocabulary.yml. May be empty: a note about the machinery has no subject, and a decorative one is worse than none."
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "benchmarks-validation",
          "finite-elements",
          "meshing",
          "parallel-hpc",
          "particles-swarms",
          "solvers",
          "symbolic-codegen",
          "time-integration",
          "units-scaling"
        ]
      },
      "description": "Computational method facets, from vocabulary.yml."
    },
    "ghost_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags inherited from Ghost. Recorded so the migration loses nothing; nothing is built from them."
    },
    "legacy_doi": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
        }
      ],
      "description": "Crossref DOI minted by Rogue Scholar, resolving to the article's page on this site. Never re-minted and never re-pointed: we do not own the prefix. Bare DOI, no https://doi.org/ prefix."
    },
    "archive_doi": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
        }
      ],
      "description": "DOI we mint for the archival PDF, resolving to its deposited record. This is the identifier to circulate. It identifies a different object from legacy_doi -- a fixed PDF rather than a living page -- and the deposit declares that relation explicitly."
    }
  },
  "allOf": [
    {
      "description": "A DOI-bearing article must declare who minted it.",
      "if": {
        "properties": {
          "doi": {
            "type": "string"
          }
        },
        "required": [
          "doi"
        ]
      },
      "then": {
        "properties": {
          "doi_registrant": {
            "type": "string"
          }
        },
        "required": [
          "doi_registrant"
        ]
      }
    },
    {
      "description": "The canonical path must be the slug. A mismatch means a DOI would 404.",
      "if": {
        "required": [
          "slug",
          "canonical_path"
        ]
      },
      "then": {
        "properties": {
          "canonical_path": {
            "type": "string"
          }
        }
      }
    }
  ]
}
