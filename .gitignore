# Mirrored site binaries: 69 MB, re-fetchable while the droplet is up,
# checksummed in inventory/asset-manifest.csv. Placed under version control
# properly when the site tree is laid out in Stage 2.
assets/
_cache/
__pycache__/
*.pyc

# Build output. Never committed: it is regenerated by `pixi run build`.
_build/

# Archival PDFs are regenerated by `pixi run build-pdf` and are not
# byte-deterministic, so committing them is pure churn. The copy that matters
# is the one deposited with the DOI baked in, which lives in the repository
# record rather than in git.
articles/*/*.pdf

# Article figures ARE committed, including the generated SVGs (those are
# byte-stable) and especially the screenshots, whose only other copy is the
# gitignored assets/ mirror. Sixteen figures in this corpus were hot-linked to
# a server that went away; six were recovered from the author's own copies and
# seven are gone for good. See inventory/lost-figures.md.

# Generated by scripts/build_index.py from article metadata. Editing it by hand
# would be overwritten on the next build; change the generator instead.
/index.md

# Generated by scripts/build_index.py from article tags.
/topics/

# Generated by scripts/build_pages.py from the Ghost export. The markdown is
# regenerated every build; the figures are NOT, because they are fetched from
# the Ghost mirror and from GitHub, and neither is available in CI. They are
# committed for the same reason the article figures are: a build must not
# depend on a server still being there.
/pages/*.md
